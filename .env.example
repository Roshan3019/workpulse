# ---------------------------------------------------------------------------
# WorkPulse environment
# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
# Server-only. NEVER expose to the browser. Only needed for admin scripts, and —
# when set — as the fallback transport for invitation emails (see docs/EMAIL.md).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used to build invite links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Invitation emails. Without one of these, invites are created and the link is
# shown for you to send yourself — nobody is emailed. Any address needs a real
# provider: Supabase's built-in mailer only reaches your own team's addresses.
#   RESEND_API_KEY   re_...                    https://resend.com  (100/day free)
#   BREVO_API_KEY    xkeysib-...               https://brevo.com
#   INVITE_FROM_EMAIL  WorkPulse <hello@yourdomain.com>
# Full walkthrough: docs/EMAIL.md
RESEND_API_KEY=
BREVO_API_KEY=
INVITE_FROM_EMAIL=WorkPulse <onboarding@resend.dev>

# Demo mode: when "1" the app runs on an in-memory store with sample data and
# a user picker on /login — no Supabase project required. Set to "0" (or remove)
# for production.
NEXT_PUBLIC_DEMO_MODE=0
